# ============================================================
# SentinelAI
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=SentinelAI
# APP_ENV is one of: development | test | staging | production.
# Non-development environments must replace every "change_me" secret below with a
# real value — the application fails fast on startup otherwise.
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# LOG_FORMAT is one of: text (human-readable, local dev) | json (structured, for
# containers/production). An invalid value is rejected fail-fast on startup.
LOG_FORMAT=text
# Minimum severity written to the log (standard Python level names).
# LOG_LEVEL=INFO

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# Inside the compose network the host is the service name "postgres". The
# `data` profile also publishes 127.0.0.1:5432, so a backend or the live test
# suite running on the host uses POSTGRES_HOST=localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=change_me

# Connection-pool tuning (ES-067; defaults shown). The request path and the two
# background projectors share this pool. A bounded checkout timeout makes an
# exhausted pool fail fast instead of hanging a request; recycle pre-empts
# connections dropped by an idle timeout or a network middlebox.
# POSTGRES_POOL_SIZE=5
# POSTGRES_POOL_MAX_OVERFLOW=10
# POSTGRES_POOL_TIMEOUT_SECONDS=30
# POSTGRES_POOL_RECYCLE_SECONDS=1800

# ------------------------------------------------------------
# Neo4j
# ------------------------------------------------------------

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------

QDRANT_URL=http://qdrant:6333

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------
# AI
# ------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Consumed through the SecretProvider by the Gemini LLM adapter (ES-043).
GOOGLE_API_KEY=
# Consumed through the SecretProvider by the NVIDIA NIM LLM adapter (ES-054).
NVIDIA_API_KEY=

# Active LLM adapter: gemini (default) | nvidia (ES-054). The embedding
# provider stays on Gemini regardless (the Qdrant collection's vector
# dimension is bound to it, ES-050).
# LLM_PROVIDER=gemini

# Optional failover provider (ES-067): when the primary fails or its circuit
# is open, this adapter serves the call instead of escalating the run. Must
# differ from LLM_PROVIDER; unset (the default) keeps single-provider
# behavior. Requires the fallback provider's key — without it the chain is
# skipped and the primary is used alone.
# LLM_FALLBACK_PROVIDER=nvidia

# Provider-edge resilience policy (ES-067, ADR-013 §4) — one shared policy for
# every AI adapter. Retries multiply a call's worst-case wall-clock time by the
# attempt count, and a run makes several sequential LLM calls, so the default
# is one retry. Only transient failures (timeout, transport, 429/5xx) are
# retried; a 4xx never is.
# AI_RESILIENCE_MAX_ATTEMPTS=2
# AI_RESILIENCE_BACKOFF_BASE_SECONDS=0.5
# AI_RESILIENCE_BACKOFF_MAX_SECONDS=8
# Consecutive transient failures that open a provider's circuit, and how long
# it then refuses calls before admitting one probe.
# AI_RESILIENCE_BREAKER_FAILURE_THRESHOLD=5
# AI_RESILIENCE_BREAKER_RESET_SECONDS=30

# NVIDIA NIM adapter configuration (defaults shown; the key is above).
# NVIDIA_MODEL=minimaxai/minimax-m3
# Reasoning models are slow per call — 180s is the ES-059 demo-proven bound.
# (Plan rate limits, e.g. 40 rpm, are never approached: a run makes ~6
# sequential calls and per-call latency dominates.)
# NVIDIA_TIMEOUT_SECONDS=180
# NVIDIA_TEMPERATURE=0
# NVIDIA_MAX_TOKENS=8192

# Gemini adapter configuration (defaults shown; the key is above, never here).
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_TEMPERATURE=0

# Gemini embedding adapter (ES-049/050; same GOOGLE_API_KEY, separate model/bound).
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_TIMEOUT_SECONDS=30
# Fixed embedding dimension (must match the Qdrant collection's vector size).
# GEMINI_EMBEDDING_DIMENSIONS=768

# External knowledge adapters (ES-058): comma-separated closed vocabulary.
#   attack — bundled MITRE ATT&CK technique catalog (offline, deterministic)
#   nvd    — live NVD CVE REST API 2.0 lookups
# Empty value opts external knowledge out (the EXTERNAL retrieval strategy
# then contributes nothing). Failures are contained per provider.
# EXTERNAL_KNOWLEDGE_PROVIDERS=attack,nvd

# Optional by NVD's own contract (keyless access is rate-limited harder);
# consumed through the SecretProvider when present.
NVD_API_KEY=
# NVD adapter configuration (defaults shown).
# NVD_TIMEOUT_SECONDS=15
# NVD_RESULTS_LIMIT=5

# ------------------------------------------------------------
# Authentication (ES-046 dev-grade / ES-062 production JWT)
# ------------------------------------------------------------

# Active authenticator: dev (default) | jwt (ES-062). The port stays
# technology-neutral; this selects the concrete adapter.
# AUTH_PROVIDER=dev

# --- dev provider (AUTH_PROVIDER=dev) ---
# Shared bearer secret for the dev authenticator. Clients send
#   Authorization: Bearer <subject>:<DEV_AUTH_TOKEN>
# Unset => every protected request is rejected (401, secure by default).
DEV_AUTH_TOKEN=

# --- jwt provider (AUTH_PROVIDER=jwt) ---
# HS256 signing/verification secret, consumed through the SecretProvider (never
# a settings field). Unset => every protected request is 401. In a real
# deployment the external IdP issues tokens; locally, mint one with:
#   AUTH_JWT_SECRET=<secret> python scripts/mint_dev_jwt.py --subject koray
AUTH_JWT_SECRET=
# Optional JWT verifier tuning (defaults shown). Leeway absorbs clock skew on
# exp/nbf; issuer/audience are enforced only when set.
# AUTH_JWT_LEEWAY_SECONDS=30
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=

# Cycle budget of the synchronous investigation run surface (default 3).
# RUN_CYCLE_BUDGET=3

# ------------------------------------------------------------
# Audit sink (ES-069, ADR-018)
# ------------------------------------------------------------

# durable (default) — the append-only, hash-chained audit log in PostgreSQL:
# records survive log rotation and restarts, and alteration/removal/reordering
# is detectable. log — the log-only recorder, which satisfies none of those
# properties; only for a deployment running without the authoritative store.
# AUDIT_SINK=durable
# How long audit records are kept. Deployment policy: a legal/organizational
# decision, not an architectural one (data-lifecycle §3). Expiry removes whole
# expired records and never edits a retained one.
# AUDIT_RETENTION_DAYS=365

# Note (ES-069, secrets-management §6): outside development, the secrets the
# *configured* capabilities need must be present at startup or the backend
# refuses to start — a missing key is a configuration failure, not a per-request
# 503. With APP_ENV=production and AUTH_PROVIDER=jwt + LLM_PROVIDER=nvidia, that
# means AUTH_JWT_SECRET, NVIDIA_API_KEY and (while the embedding projector runs)
# GOOGLE_API_KEY. NVD_API_KEY is optional by NVD's own contract and never
# required. Development keeps lazy resolution, so a partially configured local
# environment stays workable.

# ------------------------------------------------------------
# Request edge (ES-068, api-design §10/§13)
# ------------------------------------------------------------

# Per-identity, per-operation request budget. Disabled by default so local
# development and the test suites are never throttled; the staging/production
# compose overlays turn it on. Over-budget requests get 429 + Retry-After with
# the standard error envelope, counted as sentinelai_rate_limited_total.
# The budget is per API instance — several instances each enforce their own.
# RATE_LIMIT_ENABLED=false
# Default budget, applied to every operation but the run surface.
# RATE_LIMIT_REQUESTS=120
# RATE_LIMIT_WINDOW_SECONDS=60
# The investigation run surface drives the Investigation Loop (several
# sequential provider calls), so it carries its own, much smaller budget.
# RATE_LIMIT_RUN_REQUESTS=5
# RATE_LIMIT_RUN_WINDOW_SECONDS=60
# Upper bound on tracked (tenant, subject, operation) keys.
# RATE_LIMIT_MAX_TRACKED_KEYS=4096

# The in-process outbox projector that drains memory writes into the vector
# store (ES-050, ADR-012; defaults shown). Disabling it stops embedding
# production — memory items are still written and readable, their derived
# embeddings simply stop appearing; the outbox keeps the backlog until a
# projector runs again.
# OUTBOX_PROJECTOR_ENABLED=true
# OUTBOX_POLL_INTERVAL_SECONDS=2

# Embedding projection retry policy (ES-067, ADR-012; defaults shown). A failed
# record backs off and is retried, then dead-lettered once the budget is spent
# — terminal but observable (sentinelai_projection_dead_letters_total). Patient
# on purpose: the projection is background work, so a slow recovery only delays
# an embedding, while a tight retry loop burns provider quota. The Memory Item
# itself is never affected — only its derived embedding.
# PROJECTION_MAX_ATTEMPTS=5
# PROJECTION_BACKOFF_BASE_SECONDS=5
# PROJECTION_BACKOFF_MAX_SECONDS=300

# ------------------------------------------------------------
# Evidence payload store (ES-060, ADR-015)
# ------------------------------------------------------------

# Root directory of the content-addressed filesystem payload store. Relative
# paths resolve against the backend working directory (dev default);
# deployments set an absolute path onto a mounted volume.
# EVIDENCE_PAYLOAD_ROOT=var/evidence-payloads
# Maximum accepted payload size in bytes (413 above the bound).
# EVIDENCE_PAYLOAD_MAX_BYTES=10485760
# Erasure strategy (ES-070, ADR-015 §6 / ADR-017 §6). false (default) deletes
# the file — honest for local disk. true stores payloads encrypted and erases
# by destroying the key, so bytes surviving in an immutable tier, a snapshot or
# a backup are unrecoverable. The keys then live under <root>/keys, which a
# deployment must keep OUT of its backups — a backed-up key tier is not
# shredding, it is theatre.
# EVIDENCE_PAYLOAD_CRYPTO_SHRED=false

# ------------------------------------------------------------
# Retention enforcement (ES-070, data-lifecycle §3)
# ------------------------------------------------------------

# How long investigations are kept before the sweep erases them, through the
# same erase path an analyst's request uses. **0 (default) disables it** — no
# retention period is architecturally correct, and automatically erasing an
# analyst's work because nobody chose a number would be the worst kind of
# helpful. Durations are deployment policy; enforcement is the platform's.
# RETENTION_INVESTIGATION_DAYS=0
# RETENTION_SWEEP_INTERVAL_SECONDS=3600
# RETENTION_SWEEP_BATCH_SIZE=50

# ------------------------------------------------------------
# Granted capabilities (ES-070, RFC-005/ADR-019)
# ------------------------------------------------------------

# Destroying organizational knowledge (Memory items, graph entities) requires
# the `knowledge:erase` capability — reading and promoting it does not. With
# AUTH_PROVIDER=jwt the credential's `capabilities` claim carries it. The dev
# provider has no identity provider to assert it, so it grants this configured
# list (comma-separated, empty by default = closed).
# AUTH_DEV_CAPABILITIES=knowledge:erase